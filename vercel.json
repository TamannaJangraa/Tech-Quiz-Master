{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "admin": {
      "root": "admin/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
},
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}